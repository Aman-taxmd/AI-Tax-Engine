# .env.example — copy to .env and fill in real values
#
#   cp .env.example .env
#
# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Same DB_* convention as TaxMD-TaxCore's .env. If DB_NAME/DB_USER are unset,
# db/session.py falls back to a local SQLite file under var/ instead.
DB_NAME=ai_tax_engine
DB_USER=postgres
DB_PASSWORD=postgres123
DB_HOST=localhost
DB_PORT=5432

# Alternative: set a full SQLAlchemy URL directly (overrides DB_* above).
# DATABASE_URL=postgresql+psycopg2://postgres:postgres123@localhost:5432/ai_tax_engine

# ── AWS Bedrock (knowledge extraction LLM) ─────────────────────────────────────
# Leave AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY unset to use the default boto3
# credential chain (env vars / ~/.aws/credentials / IAM role). When both are
# absent AND no chain credentials resolve, the pipeline falls back to a
# deterministic stub extractor (see build/graph/llm_client.py) so the pipeline
# stays runnable without live AWS access.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed for TEMPORARY credentials (AWS_ACCESS_KEY_ID starts with
# "ASIA" — e.g. AWS SSO or an assumed role). Leave blank for a permanent IAM
# user key ("AKIA..."). Temporary tokens also expire (often in ~1-12h) and
# will need refreshing periodically.
AWS_SESSION_TOKEN=
AWS_BEDROCK_REGION_NAME=us-east-1

# Claude Sonnet 4.5 — same model TaxMD-TaxCore uses for its intent classifier
# (INTENT_CLASSIFICATION_MODEL_ID in its .env.example).
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.0
